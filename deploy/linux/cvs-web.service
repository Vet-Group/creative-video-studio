# Creative Video Studio web app on port 3400 (CVS_WEB_PORT in .env), a root user unit.
# install.sh fills @APP@ and builds first; scripts/next.ts loads <app>/.env and runs `next start`.
[Unit]
Description=Creative Video Studio web (Next.js, port 3400)

[Service]
WorkingDirectory=@APP@/apps/web
Environment=PATH=@APP@/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
# Only the Cloudflare tunnel (127.0.0.1:3400) reaches the app; sign-in rate limits trust its cf-connecting-ip.
Environment=CVS_WEB_HOST=127.0.0.1
ExecStart=@APP@/node/bin/node scripts/next.ts start
Restart=on-failure
RestartSec=5
# Set by plan step D.3 from the measured VET headroom (docs/ops/production.md).
MemoryMax=768M

[Install]
WantedBy=default.target
