#!/usr/bin/env bash
# Forced command for the autonomous run's SSH key on vet-linux (plan A.0, A.0c). Installed at /usr/local/sbin/cvs-run-gate.
# authorized_keys: command="/usr/local/sbin/cvs-run-gate",no-pty,no-port-forwarding,no-agent-forwarding,no-X11-forwarding <key>
# Only the verbs below run; anything else is refused and logged. Every write is confined to /opt/creative-video-studio,
# cvs-* units and the compose project creative-video-studio. CVS_GATE_DRY_RUN=1 prints the action instead of running it.
set -euo pipefail

APP=/opt/creative-video-studio
LOG=/var/log/cvs-run-gate.log
read -r -a ARGV <<<"${SSH_ORIGINAL_COMMAND:-}"
VERB="${ARGV[0]:-}"

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >>"$LOG" 2>/dev/null || true; }
refuse() { log "REFUSED: ${SSH_ORIGINAL_COMMAND:-<empty>}"; echo "cvs-run-gate: refused: $1" >&2; exit 2; }
run() { if [[ "${CVS_GATE_DRY_RUN:-}" == 1 ]]; then echo "DRY-RUN: $*"; else "$@"; fi; }

# The POD Studio MinIO container: the one MinIO container that belongs to neither this app nor Ideas Hub.
pod_minio() {
  docker ps --format '{{.Names}}' | grep -i minio | grep -viE 'creative-video-studio|ideas-hub' | head -n 1
}

log "RUN: ${SSH_ORIGINAL_COMMAND:-<empty>}"
case "$VERB" in
  check) # D.3, read-only
    [[ ${#ARGV[@]} -eq 1 ]] || refuse 'check takes no arguments'
    run ss -ltnp
    run free -h
    run df -h
    run systemctl show user@0.service -p MemoryMax,CPUQuota
    run cat /sys/fs/cgroup/user.slice/user-0.slice/user@0.service/memory.current
    run docker ps --format '{{.Names}}\t{{.Image}}\t{{.Status}}'
    run systemctl list-units --type=service --no-pager --plain
    run env XDG_RUNTIME_DIR=/run/user/0 systemctl --user list-units --no-pager --plain
    run node --version || true
    ;;
  sample-neighbours) # D.5, read-only: container health, Ideas Hub units, Ideas Hub public URL
    [[ ${#ARGV[@]} -eq 1 ]] || refuse 'sample-neighbours takes no arguments'
    run docker ps --format '{{.Names}}\t{{.Status}}'
    run env XDG_RUNTIME_DIR=/run/user/0 systemctl --user is-active 'ideashub-*' || true
    run curl -s -o /dev/null -m 10 -w 'ideas.vetgroup.net %{http_code}\n' https://ideas.vetgroup.net/ || true
    ;;
  fetch-inputs) # B.3, read-only from POD Studio MinIO; the credential is read inside the container and never echoed
    case "${ARGV[1]:-}" in
      buckets) [[ ${#ARGV[@]} -eq 2 ]] || refuse 'usage: fetch-inputs buckets'; cmd='mc ls g' ;;
      list)
        [[ ${#ARGV[@]} -eq 3 && "${ARGV[2]}" =~ ^[a-z0-9.-]+(/[A-Za-z0-9._/-]*)?$ && "${ARGV[2]}" != *..* ]] || refuse 'usage: fetch-inputs list <bucket>[/prefix]'
        cmd="mc ls --recursive g/${ARGV[2]}" ;;
      cat)
        [[ ${#ARGV[@]} -eq 3 && "${ARGV[2]}" =~ ^[a-z0-9.-]+/[A-Za-z0-9._/-]+\.(jpe?g|png|webp|JPE?G|PNG|WEBP)$ && "${ARGV[2]}" != *..* ]] || refuse 'usage: fetch-inputs cat <bucket>/<image key>'
        cmd="mc cat g/${ARGV[2]}" ;;
      *) refuse 'fetch-inputs buckets|list|cat' ;;
    esac
    # Arguments are validated above, so only [A-Za-z0-9._/-] reaches this shell string.
    c="$(pod_minio)"
    [[ -n "$c" ]] || refuse 'POD Studio MinIO container not found'
    run docker exec "$c" sh -c "mc alias set g http://127.0.0.1:9000 \"\$MINIO_ROOT_USER\" \"\$MINIO_ROOT_PASSWORD\" >/dev/null && $cmd"
    ;;
  deploy) # D.5: check out one commit with the read-only deploy key, then run the repo's own installer
    [[ ${#ARGV[@]} -eq 2 && "${ARGV[1]}" =~ ^[0-9a-f]{40}$ ]] || refuse 'usage: deploy <40-hex commit>'
    if [[ ! -d "$APP/.git" ]]; then
      run env GIT_SSH_COMMAND='ssh -i /root/.ssh/cvs_deploy_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new' git clone git@github.com:anhtahaylove/creative-video-studio.git "$APP"
    fi
    run env GIT_SSH_COMMAND='ssh -i /root/.ssh/cvs_deploy_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new' git -C "$APP" fetch --quiet origin
    run git -C "$APP" checkout --quiet --detach "${ARGV[1]}"
    run bash "$APP/deploy/linux/install.sh"
    ;;
  status | backup | drill | uninstall)
    [[ ${#ARGV[@]} -le 2 ]] || refuse "usage: $VERB [--dry-run]"
    [[ ${#ARGV[@]} -eq 1 || "${ARGV[1]}" == --dry-run ]] || refuse "only --dry-run is accepted after $VERB"
    case "$VERB" in
      status) script=status.sh ;;
      backup) script=cvs-backup ;;
      drill) script='cvs-backup --drill' ;;
      uninstall) script=uninstall.sh ;;
    esac
    [[ -d "$APP/deploy/linux" ]] || refuse 'not deployed yet'
    # shellcheck disable=SC2086 # $script deliberately splits into the script and its flag
    run bash "$APP/deploy/linux/"$script ${ARGV[1]:-}
    ;;
  *)
    refuse "unknown verb '${VERB}'"
    ;;
esac
