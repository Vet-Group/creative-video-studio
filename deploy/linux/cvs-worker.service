# Creative Video Studio worker, a root user unit. install.sh fills @APP@.
# Run tsx directly: pnpm can report a failed task after a clean worker shutdown.
# The worker reads <app>/.env itself (DATABASE_URL and the S3 settings).
[Unit]
Description=Creative Video Studio worker

[Service]
WorkingDirectory=@APP@
Environment=PATH=@APP@/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=@APP@/node/bin/node @APP@/apps/worker/node_modules/tsx/dist/cli.mjs @APP@/apps/worker/src/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# The reference-video analysis (rea-video) peaks around 850 MB (opencv + onnxruntime + 720p frame buffers)
# on top of the Node worker, so this is 2G, not the 768M the rest of the worker needs. The box has 31 GB and
# runs only CVS (docs/ops/production.md).
MemoryMax=2G

[Install]
WantedBy=default.target
