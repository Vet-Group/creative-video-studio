{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // These scripts run directly under Node's type stripping, so imports carry .ts and no TS-only syntax is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
