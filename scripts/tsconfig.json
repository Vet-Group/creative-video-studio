{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // preflight and run/ run under Node's type stripping and bakeoff/ under tsx (it imports @cvs/core sources), so imports carry .ts and no TS-only syntax is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
