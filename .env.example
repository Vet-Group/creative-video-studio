# Local development values matching docker-compose.yml. Copy to .env; never commit .env.
DATABASE_URL=postgres://cvs:cvs-local-only@127.0.0.1:5435/cvs
S3_ENDPOINT=http://127.0.0.1:9400
S3_ACCESS_KEY_ID=cvs
S3_SECRET_ACCESS_KEY=cvs-local-only
S3_BUCKET=cvs-media
# Cloudflare R2 for direct browser uploads (the /analyze reference video, past the request-body and tunnel caps). Leave these
# four empty for local dev (the MinIO path above handles every upload); set them in production to a bucket with the app origin
# in its CORS, and an R2 API token scoped to it. R2_ENDPOINT is https://<account>.r2.cloudflarestorage.com.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Compose project and host ports (defaults shown). Each worktree's .env uses project creative-video-studio-b with ports +10
# or creative-video-studio-m with ports +20, and DATABASE_URL, S3_ENDPOINT and APP_URL must match.
# COMPOSE_PROJECT_NAME=creative-video-studio
# CVS_PG_PORT=5435
# CVS_S3_PORT=9400
# CVS_S3_CONSOLE_PORT=9401
# CVS_WEB_PORT=3400
# Web app: base URL and the better-auth signing secret (generate a long random value for .env).
APP_URL=http://localhost:3400
BETTER_AUTH_SECRET=

# ---- Owner-provided values for the autonomous run (see docs/ops/PREFLIGHT.md). `pnpm preflight` checks each one. ----
# Video providers, prepaid accounts only.
FAL_KEY=
# Optional second fal key, the "VET Group" team account: new fal jobs move to it once FAL_KEY's account runs out (apps/worker/src/fal-next.ts).
FAL_KEY_NEXT=
# Optional comma-separated Lark emails or open_ids of the CVS app that get the hourly fal low-balance alert instead of the Admins (apps/worker/src/fal-alert.ts).
FAL_ALERT_LARK_TO=
# OpenAI Platform key: Enhance, suggestions and translations run on gpt-6-luna when set, else on fal (FAL_KEY).
OPENAI_API_KEY=
# BytePlus ModelArk (Seedance, Seedream), an API key from https://console.byteplus.com; the worker wires the provider only when it is set.
BYTEPLUS_ARK_API_KEY=
# Vertex AI image models (Nano Banana, Virtual Try-On, Product Recontext): a service account with the Vertex AI User role.
# The worker reads the JSON key file at this path; the project defaults to the key's project_id, the region (Imagen models) to us-central1.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Optional second Vertex account (its key's project_id names it), used after account 1 when that one's credits end (docs/ops/vertex-accounts.md).
GOOGLE_APPLICATION_CREDENTIALS_NEXT=
# Reference-video analysis (rea-video). Set to 1 to turn the feature on: the worker subscribes the analyze queue and the
# /analyze page and its API come alive. Needs rea-video + ffmpeg installed on the worker; the VLM runs on BYTEPLUS_ARK_API_KEY.
REA_ANALYZE_ENABLED=
# Analysis VLM fallback: set to 1 to let the analysis fall back to the configured Vertex account when BytePlus is unreachable.
# Off by default (BytePlus only); turn on only once a billed Vertex project is wired for analysis.
REA_VLM_VERTEX_FALLBACK=
# Lark OAuth app in the company tenant.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_TENANT_KEY=
# Google OAuth web client (any Google account may try; only users an Admin added get in).
# Redirect URI: https://video.vetgroup.net/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Support email shown on /privacy; also the one entered on the Google Branding page.
CVS_SUPPORT_EMAIL=
# Weekly off-host backup: s3:https://<account>.r2.cloudflarestorage.com/<bucket>, a key scoped to that bucket, and the restic password.
CVS_R2_REPOSITORY=
CVS_R2_ACCESS_KEY_ID=
CVS_R2_SECRET_ACCESS_KEY=
CVS_RESTIC_PASSWORD=
# Cloudflare token with Tunnel and DNS edit rights on the vetgroup.net zone only.
CLOUDFLARE_API_TOKEN=
# First Admin on the server.
CVS_ADMIN_EMAIL=
CVS_ADMIN_PASSWORD=
# Optional: the owner's Lark open_id for run notifications (defaults to ~/.omniroute/quota-notify.json).
CVS_OWNER_LARK_OPEN_ID=
