# Local development values matching docker-compose.yml. Copy to .env; never commit .env.
DATABASE_URL=postgres://cvs:cvs-local-only@127.0.0.1:5435/cvs
S3_ENDPOINT=http://127.0.0.1:9400
S3_ACCESS_KEY_ID=cvs
S3_SECRET_ACCESS_KEY=cvs-local-only
S3_BUCKET=cvs-media
# Compose project and host ports (defaults shown). Each worktree's .env uses project creative-video-studio-b with ports +10
# or creative-video-studio-m with ports +20, and DATABASE_URL, S3_ENDPOINT and APP_URL must match.
# COMPOSE_PROJECT_NAME=creative-video-studio
# CVS_PG_PORT=5435
# CVS_S3_PORT=9400
# CVS_S3_CONSOLE_PORT=9401
# CVS_WEB_PORT=3400
# Web app: base URL and the better-auth signing secret (generate a long random value for .env).
APP_URL=http://localhost:3400
BETTER_AUTH_SECRET=

# ---- Owner-provided values for the autonomous run (see docs/ops/PREFLIGHT.md). `pnpm preflight` checks each one. ----
# Video providers, prepaid accounts only.
FAL_KEY=
REPLICATE_API_TOKEN=
# Lark OAuth app in the company tenant.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_TENANT_KEY=
# Weekly off-host backup: s3:https://<account>.r2.cloudflarestorage.com/<bucket>, a key scoped to that bucket, and the restic password.
CVS_R2_REPOSITORY=
CVS_R2_ACCESS_KEY_ID=
CVS_R2_SECRET_ACCESS_KEY=
CVS_RESTIC_PASSWORD=
# Cloudflare token with Tunnel and DNS edit rights on the vetgroup.net zone only.
CLOUDFLARE_API_TOKEN=
# First Admin on the server.
CVS_ADMIN_EMAIL=
CVS_ADMIN_PASSWORD=
# Optional: the owner's Lark open_id for run notifications (defaults to ~/.omniroute/quota-notify.json).
CVS_OWNER_LARK_OPEN_ID=
