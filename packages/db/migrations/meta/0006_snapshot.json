          "name": "cost_entries_shared_unattributed_check",
          "value": "\"cost_entries\".\"job_id\" is not null or (\"cost_entries\".\"user_id\" is null and \"cost_entries\".\"team_id\" is null and \"cost_entries\".\"store_id\" is null)"
        },
        "cost_entries_day_check": {
