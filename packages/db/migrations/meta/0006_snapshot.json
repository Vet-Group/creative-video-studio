        "cost_entries_job_shared_check": {
          "name": "cost_entries_job_shared_check",
          "value": "(\"cost_entries\".\"job_id\" is null) = (\"cost_entries\".\"kind\" in ('bakeoff', 'manual_adjustment', 'invoice_diff'))"
        },
        "cost_entries_manual_note_check": {
          "name": "cost_entries_manual_note_check",
          "value": "\"cost_entries\".\"kind\" <> 'manual_adjustment' or coalesce(length(trim(\"cost_entries\".\"note\")), 0) > 0"
        },
        "cost_entries_month_check": {
          "name": "cost_entries_month_check",
